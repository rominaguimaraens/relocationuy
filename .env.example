# Booking page for the free 30-minute call (Cal.com, Calendly, Google appointment schedule...).
# Leave empty to hide the "Pick a time" card on the contact page.
VITE_SCHEDULER_URL=

# The client tracking sheet link is NOT set here. It is a secret that must never reach the browser.
